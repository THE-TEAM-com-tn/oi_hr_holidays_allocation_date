<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Make the Time Off calendar ("Everyone's Time Off") private.

        The hr.leave.report.calendar model (the model behind the calendar view)
        ships in Odoo 17 with ONLY a global multi-company rule, so every employee
        can see everyone's time off on the calendar. We add per-group record rules,
        driven by the DEDICATED groups defined in
        security/hr_leave_calendar_groups.xml (the "holiday_allocation_date_app"
        access-rights selector), so that:

          - Own Time Off Only  (group_holiday_calendar_own)  -> sees only their own
          - Own + Team         (group_holiday_calendar_team) -> own + their team
          - Everyone's Time Off(group_holiday_calendar_all)  -> sees everyone

        Because every internal user gets "Own Time Off Only" by default (see the
        base.group_user wiring in hr_leave_calendar_groups.xml), a normal user is
        always constrained to their own records and CANNOT see other employees'
        calendars unless an admin raises their tier in the dropdown.

        Record rules combine as:
            (AND of global rules) AND (OR of the user's applicable group rules)
        so the permissive "team"/"everyone" rules "open up" the view via OR for
        users granted those tiers, while a regular member stays constrained to
        their own records. This mirrors the existing privacy already enforced on
        hr.leave and hr.leave.allocation.
    -->

    <record id="hr_leave_report_calendar_rule_own" model="ir.rule">
        <field name="name">Time Off Calendar: own only (holiday_allocation_date_app)</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave_report_calendar"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_holiday_calendar_own'))]"/>
    </record>

    <record id="hr_leave_report_calendar_rule_team" model="ir.rule">
        <field name="name">Time Off Calendar: own + team (holiday_allocation_date_app)</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave_report_calendar"/>
        <field name="domain_force">['|', ('employee_id.user_id', '=', user.id), ('employee_id.leave_manager_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_holiday_calendar_team'))]"/>
    </record>

    <record id="hr_leave_report_calendar_rule_all" model="ir.rule">
        <field name="name">Time Off Calendar: everyone (holiday_allocation_date_app)</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave_report_calendar"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_holiday_calendar_all'))]"/>
    </record>

</odoo>
